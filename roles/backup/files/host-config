#!/bin/bash

# Target host configuration
HOST="ark.c12z.de"        # Target hostname or IP
MAC="24:5e:be:06:ae:ee"   # Target MAC address for Wake-on-LAN
SSH_USER="tardis"          # SSH user on target host

# systemd unit to verify is running (leave empty to skip). multi-user.target
# is reached once a vanilla Debian system has finished booting to normal
# multi-user mode; note it stays "active" even if some unrelated unit failed
# along the way, it only means boot got that far.
SERVICE="multi-user.target"

# Interface etherwake sends the raw Wake-on-LAN frame on. Needed when the
# target isn't on the host's default interface, e.g. it's on a VLAN bridge
# such as br-srv (see roles/network-trunked). Leave empty for etherwake's
# default (eth0).
#
# Note I: etherwake needs a raw socket (CAP_NET_RAW), so it must run as root;
# wakeonlan needs no special privileges.
#
# Note II: If this is set, etherwake will be used and required to be installed
# while if not set, wakeonlan is preferred but either needs to be installed.
WOL_INTERFACE="br-srv"
