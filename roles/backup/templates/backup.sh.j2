#!/bin/bash
set -euo pipefail

# Generated by Ansible (roles/backup) for {{ inventory_hostname }} - re-run
# the playbook to update, don't edit by hand.
#
# RESTIC_REPOSITORY_BASE (with this host's restic-rest-server credentials
# already embedded) and RESTIC_PASSWORD (this host's repo encryption
# password) both come from /opt/backup/server.conf (see tasks/client.yml) -
# root-only (0600), same as this script itself.
source /opt/backup/server.conf
: "${RESTIC_REPOSITORY_BASE:?RESTIC_REPOSITORY_BASE not set in /opt/backup/server.conf - is backup_server_password defined for this host?}"
: "${RESTIC_PASSWORD:?RESTIC_PASSWORD not set in /opt/backup/server.conf - is backup_restic_password defined for this host?}"
export RESTIC_PASSWORD  # restic reads this from its process environment, not passed as an arg

{# Relative excludes (no leading /) are resolved against the entry's own
   path, so e.g. exclude: [incoming] on an entry with path /tank/assets
   means /tank/assets/incoming, not a bare "incoming" pattern matching
   anywhere - restic itself has no notion of "relative to this entry". #}
{% macro restic_args(entry) -%}
{% if entry.oneFileSystem | default(false) %}--one-file-system {% endif -%}
{% for ex in entry.exclude | default([]) %}{{ ('--exclude=' ~ (ex if ex.startswith('/') else (entry.path.rstrip('/') ~ '/' ~ ex))) | quote }} {% endfor %}
{%- endmacro -%}
/opt/backup/ensure-server-on

# One restic repository per tier: system is shared by every host (see
# defaults/main.yml), assets/configs are this host's own, with each entry
# told apart by a --tag of its key. The hostname segment matches the
# private-repos username restic-rest-server authenticates this host as (see
# tasks/client.yml). Snapshots are explicitly tagged with this host's
# inventory name via --host rather than whatever the OS hostname happens to
# be - in the shared system repository that's the only thing telling hosts'
# snapshots apart (and restic picks each backup's parent snapshot by host +
# path). Remaining args go to restic backup as-is.
backup_entry() {
    local label="$1" tier="$2" path="$3"
    shift 3
    local repo="$RESTIC_REPOSITORY_BASE/{{ inventory_hostname }}/$tier"
    # First run against this repository: restic-rest-server only creates the
    # directory (tasks/client.yml), not the repository itself, so init it
    # here. The shared system repository is normally already initialized
    # (with this host's key added) by tasks/client.yml - this only kicks in
    # for it when this host is the very first one to use it.
    if ! restic -r "$repo" cat config >/dev/null 2>&1; then
        echo "==> $label: initializing repository"
        restic -r "$repo" init
    fi
    echo "==> $label: $path ($*)"
    restic -r "$repo" backup --host {{ inventory_hostname | quote }} "$@" "$path"
}

{% if 'system' in backup_client_tiers %}
{# Everything the assets/configs tiers already back up is excluded from the
   system tier, whether or not it sits on the root filesystem (on a host
   where it does, --one-file-system alone wouldn't keep it out). #}
{% set tier_paths = (backup_assets.values() | list + backup_configs.values() | list)
     | map(attribute='path') | map('regex_replace', '(.)/+$', '\\1') | list %}
{% set system_entry = backup_system | combine({'exclude': backup_system.exclude | default([]) + tier_paths}) %}
backup_entry system system {{ backup_system.path | quote }} {{ restic_args(system_entry) }}
{% endif %}
{% for key, entry in backup_assets.items() -%}
backup_entry assets/{{ key | quote }} assets {{ entry.path | quote }} --tag {{ key | quote }} {{ restic_args(entry) }}
{% endfor -%}
{% for key, entry in backup_configs.items() -%}
backup_entry configs/{{ key | quote }} configs {{ entry.path | quote }} --tag {{ key | quote }} {{ restic_args(entry) }}
{% endfor -%}
