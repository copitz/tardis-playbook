#!/bin/bash
set -euo pipefail

# Generated by Ansible (roles/backup) for {{ inventory_hostname }} - re-run
# the playbook to update, don't edit by hand.
#
# RESTIC_REPOSITORY_BASE and RESTIC_PASSWORD both come from
# /opt/backup/server.conf - see backup.sh.j2 for details.
#
# Usage: restore <system|assets|configs> <key> [snapshot] [target-dir]
#
# <key> is the entry's own subfolder under the tier's folder on the backup
# server (see backup_assets/backup_configs in defaults/main.yml) - each
# entry has its own repository, so this is how a specific one is picked
# out. Pass "" for the system tier, which has no key.

source /opt/backup/server.conf
: "${RESTIC_REPOSITORY_BASE:?RESTIC_REPOSITORY_BASE not set in /opt/backup/server.conf - is backup_server_password defined for this host?}"
: "${RESTIC_PASSWORD:?RESTIC_PASSWORD not set in /opt/backup/server.conf - is backup_restic_password defined for this host?}"
export RESTIC_PASSWORD  # restic reads this from its process environment, not passed as an arg

tier="${1:?tier required (system|assets|configs)}"
key="${2?key required (empty string for system)}"
snapshot="${3:-latest}"
target="${4:-/}"

# hostname segment matches the private-repos username restic-rest-server
# authenticates this host as - see backup.sh.j2's backup_entry(), including
# why this is "$tier-$key" rather than "$tier/$key".
repo="$RESTIC_REPOSITORY_BASE/{{ inventory_hostname }}/$tier${key:+-$key}"

echo "==> Restoring $repo@$snapshot into $target"
restic -r "$repo" restore "$snapshot" --target "$target"
