#!/usr/bin/python3
# Generated by Ansible (roles/network) for {{ inventory_hostname }} - re-run
# the playbook to update, don't edit by hand.
#
# Prefers ethernet over wifi - but only when ethernet actually is in the right
# network: a link alone (carrier) isn't enough, the gateway must also answer an
# ARP probe on it. Routers only answer ARP for their address on the VLAN it
# lives in, so a cable in a port of another VLAN is ignored. The probe is sent
# from 0.0.0.0 (RFC 5227), so it needs no address on ethernet and doesn't leak
# ours into a wrong network.
#
# While ethernet is good, it's brought up and wifi taken down with its radio
# switched off (rfkill) - otherwise wifi is brought up and ethernet down. Both
# ifaces are left unconfigured in /etc/network/interfaces except for wifi's
# allow-hotplug, so this is the only one switching between them.
import socket
import struct
import subprocess
import sys
import time

ETHERNET = "{{ network_ethernet_iface }}"
WIFI = "{{ network_wifi_iface }}"
GATEWAY = "{{ network_ethernet_gateway }}"
# Static addresses to announce (gratuitous ARP) after switching, so peers
# don't keep sending to the other iface's MAC - empty for DHCP
ADDRESSES = {ETHERNET: "{{ network_ethernet_address or '' }}", WIFI: "{{ network_wifi_address or '' }}"}

INTERVAL = 2  # Seconds between checks
UP_CHECKS = 3  # Consecutive good checks before switching to ethernet
DOWN_CHECKS = 3  # Consecutive failed probes (with link) before switching to wifi
PROBE_TIMEOUT = 1
ANNOUNCEMENTS = 3


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def run(*cmd):
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        log(f"{' '.join(cmd)} failed ({result.returncode}): {(result.stderr or result.stdout).strip()}")
    return result.returncode == 0


def read_sys(iface, attr):
    try:
        with open(f"/sys/class/net/{iface}/{attr}") as f:
            return f.read().strip()
    except OSError:
        return None


def is_up(iface):
    return subprocess.run(["ifquery", "--state", iface], capture_output=True).returncode == 0


def arp_socket(iface):
    s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(0x0806))
    s.bind((iface, 0))
    return s, s.getsockname()[4]


def arp_packet(mac, sender_ip, target_ip):
    return (b"\xff" * 6 + mac + b"\x08\x06"
            + struct.pack("!HHBBH", 1, 0x0800, 6, 4, 1)
            + mac + socket.inet_aton(sender_ip) + b"\x00" * 6 + socket.inet_aton(target_ip))


def probe_gateway():
    """Whether the gateway answers an ARP probe on ethernet"""
    try:
        s, mac = arp_socket(ETHERNET)
    except OSError as e:
        log(f"ARP probe on {ETHERNET} failed: {e}")
        return False
    with s:
        s.send(arp_packet(mac, "0.0.0.0", GATEWAY))
        gateway = socket.inet_aton(GATEWAY)
        deadline = time.monotonic() + PROBE_TIMEOUT
        while (remaining := deadline - time.monotonic()) > 0:
            s.settimeout(remaining)
            try:
                frame = s.recv(64)
            except socket.timeout:
                break
            # ARP reply (op 2) from the gateway
            if frame[20:22] == b"\x00\x02" and frame[28:32] == gateway:
                return True
    return False


def announce(iface):
    """Gratuitous ARP for iface's static address"""
    address = ADDRESSES[iface]
    if not address:
        return
    try:
        s, mac = arp_socket(iface)
        with s:
            s.send(arp_packet(mac, address, address))
    except OSError as e:
        log(f"Announcing {address} on {iface} failed: {e}")


def use_ethernet():
    if not is_up(ETHERNET):
        run("ifup", ETHERNET)
    if is_up(WIFI):
        run("ifdown", WIFI)
        run("rfkill", "block", "wlan")


def use_wifi():
    # The wifi iface's pre-up unblocks the radio
    if not is_up(WIFI):
        run("ifup", WIFI)
    if is_up(ETHERNET):
        run("ifdown", ETHERNET)


def main():
    active = None
    good = bad = 0
    announcements = 0
    while True:
        if read_sys(ETHERNET, "carrier") != "1":
            good, bad = 0, DOWN_CHECKS
            reason = "no link"
        elif probe_gateway():
            good, bad = good + 1, 0
            reason = "link not yet stable"
        else:
            good, bad = 0, bad + 1
            reason = f"no ARP reply from {GATEWAY}"

        if active != ETHERNET and good >= UP_CHECKS:
            log(f"Switching to {ETHERNET} ({GATEWAY} reachable)")
            active = ETHERNET
            announcements = ANNOUNCEMENTS
        elif active != WIFI and (active is None or bad >= DOWN_CHECKS):
            log(f"Switching to {WIFI} ({reason} on {ETHERNET})")
            active = WIFI
            announcements = ANNOUNCEMENTS

        # Enforced on every check, so it also recovers from ifup/ifdown done
        # from outside (e.g. the Ansible handler)
        if active == ETHERNET:
            use_ethernet()
        else:
            use_wifi()

        # Wifi associates only after ifup returned
        if announcements and read_sys(active, "operstate") == "up":
            announce(active)
            announcements -= 1

        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
