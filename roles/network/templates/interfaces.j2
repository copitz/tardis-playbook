{% macro inet(iface, address, subnet, gateway, metric, dns_nameservers, dns_search) %}
iface {{ iface }} inet {{ 'static' if address else 'dhcp' }}
{% if address %}
        address {{ address }}/{{ subnet | ansible.utils.ipaddr('prefix') }}
{% if gateway %}
        gateway {{ gateway }}
        metric {{ metric }}
{% endif %}
{% if dns_nameservers %}
        dns-nameservers {{ dns_nameservers | join(' ') }}
{% endif %}
{% if dns_search %}
        dns-search {{ dns_search | join(' ') }}
{% endif %}
{% endif %}
{% endmacro %}
# Generated by Ansible (roles/network) for {{ inventory_hostname }} - re-run
# the playbook to update, don't edit by hand.

source /etc/network/interfaces.d/*

# The loopback network interface
auto lo
iface lo inet loopback
{% if network_ethernet_iface %}

# Ethernet
{% if network_wifi_off_when_ethernet_up %}
# No auto/allow-hotplug: network-prefer-ethernet.service brings this up/down
# depending on whether the gateway is reachable on it.
{% else %}
allow-hotplug {{ network_ethernet_iface }}
{% endif %}
{{ inet(network_ethernet_iface, network_ethernet_address, network_ethernet_subnet, network_ethernet_gateway, network_ethernet_metric, network_ethernet_dns_nameservers, network_ethernet_dns_search) -}}
{% if network_ethernet_wol %}
        ethernet-wol {{ network_ethernet_wol }}
{% endif %}
{% endif %}
{% if network_wifi_iface %}

# WiFi
allow-hotplug {{ network_wifi_iface }}
{{ inet(network_wifi_iface, network_wifi_address, network_wifi_subnet, network_wifi_gateway, network_wifi_metric, network_wifi_dns_nameservers, network_wifi_dns_search) -}}
{% if network_wifi_off_when_ethernet_up %}
        # network-prefer-ethernet.service switches the radio off while on
        # ethernet (and systemd-rfkill restores that block after a reboot)
        pre-up rfkill unblock wlan
{% endif %}
        wpa-ssid {{ network_wifi_ssid }}
        wpa-psk {{ network_wifi_psk }}
{% endif %}
